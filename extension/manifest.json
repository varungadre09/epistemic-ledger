{
  "manifest_version": 3,
  "name": "Epistemic Ledger",
  "version": "0.1.0",
  "description": "Shows an X author's topic-level reliability, computed from their resolved track record.",
  "permissions": ["storage"],
  "host_permissions": [
    "http://localhost:8000/*",
    "http://127.0.0.1:8000/*",
    "https://*/*",
    "https://x.com/*",
    "https://twitter.com/*"
  ],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "Epistemic Ledger" },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
