# Copy to .env and fill in. NEVER commit .env.

# Supabase Postgres (libpq keyword string).
# For a PUBLIC / hosted read API, point this at a READ-ONLY role that can only
# SELECT from scores/sources — never the service-role / owner credentials.
SUPABASE_DB_URL=host=db.YOUR_PROJECT_REF.supabase.co port=5432 dbname=postgres user=postgres password=YOUR_DB_PASSWORD sslmode=require connect_timeout=10

# Anthropic — extraction + resolution (bring your own; the full pipeline spends real money)
ANTHROPIC_API_KEY=sk-ant-...

# X API v2 pay-per-use bearer token (full-archive search access)
X_BEARER_TOKEN=...

# Optional overrides
# EXTRACT_MODEL=claude-sonnet-5-5
# RESOLVE_MODEL=claude-sonnet-5-5
# X_READ_PRICE=0.005
